{
  "name": "@sitzadz/ai-shorts-generator",
  "version": "1.0.0",
  "description": "Vinci AI — self-hosted AI shorts generator: Gemini-powered script/voice/title generation, TikTok + Pinterest video search, ffmpeg rendering, and YouTube upload/scheduler with Indian-timezone (IST) Autopilot.",
  "type": "module",
  "main": "dist/server.cjs",
  "bin": {
    "vinci": "bin/vinci.cjs"
  },
  "files": [
    "dist/server.cjs",
    "dist/index.html",
    "dist/assets",
    "bin",
    "scripts",
    "server/tts.py",
    "urlebird_search.py",
    "urlebird_preview.py",
    "pinterest_video_search.py",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node bin/vinci.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc --noEmit"
  },
  "keywords": [
    "ai",
    "shorts",
    "video-generator",
    "gemini",
    "tiktok",
    "pinterest",
    "youtube-upload",
    "scheduler",
    "autopilot",
    "ffmpeg",
    "edge-tts",
    "self-hosted"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tobyg74/tiktok-api-dl": "^1.3.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
