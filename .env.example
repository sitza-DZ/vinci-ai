# ─── AI PROVIDERS ───────────────────────────────────
# At least one API key is required for script generation.

# Gemini (Google) — Recommended. Free tier available.
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq — Fast inference, generous free tier.
# GROQ_API_KEY=""

# OpenRouter — Unified API for 200+ models (Claude, GPT, Llama, etc.)
# OPENROUTER_API_KEY=""

# NVIDIA NIM — 120+ free models (Nemotron, Llama, Mistral, etc.)
# No API key needed for NVIDIA NIM — uses free API at api.nvidia.com
# NVIDIA_API_KEY=""


# ─── YOUTUBE UPLOAD ─────────────────────────────────
# This project uses cookies-based YouTube upload (no OAuth setup needed).
# Export cookies from your browser after logging into YouTube,
# then paste them in the Settings > YouTube Upload page.
#
# OAuth client/secret are optional — only needed if cookies fail.
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""


# ─── APPLICATION ────────────────────────────────────
# Encryption key for storing API keys in local DB.
# Must be exactly 32 characters long.
ENCRYPTION_SECRET="replace-with-a-32-character-random-string"

# Server port (default: 3000)
# PORT=3000

# Environment mode
# NODE_ENV="production"