# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Local HTTP server port.
PORT=3000

# ENCRYPTION_SECRET: Used for securely encrypting external API Keys (Gemini, Pexels, Pixabay) stored in the database.
ENCRYPTION_SECRET="replace-with-a-secure-32-character-random-string"

# YOUTUBE_FRONTEND_API_KEY: Required for cookies-based YouTube validation/upload.
YOUTUBE_FRONTEND_API_KEY="your-youtube-frontend-api-key"

# YOUTUBE_CLIENT_ID + YOUTUBE_CLIENT_SECRET: Required for OAuth YouTube upload fallback.
YOUTUBE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-client-secret"
